        }
      ],
      "destination": "/hello-world/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "1"
        }
      ],
      "destination": "/hello-world/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/en/home/",
